# Supabase (client-side)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY

# Spotify (optional overrides)
# VITE_SPOTIFY_CLIENT_ID=...
# VITE_SPOTIFY_REDIRECT_PATH=/spotify-callback

# Optional direct calendar connectors (public OAuth client identifiers)
# Google: enable Calendar API and authorize the application's JavaScript origin.
VITE_GOOGLE_CALENDAR_CLIENT_ID=
# Microsoft: register a SPA redirect at https://YOUR_DOMAIN/calendar-callback.html
VITE_MICROSOFT_CALENDAR_CLIENT_ID=
