# Supabase (client-side)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY

# Spotify (required for Spotify integration)
# Create an app at https://developer.spotify.com/dashboard to get your Client ID
# IMPORTANT: This must be set to use Spotify features. The app will fall back to LoFi player if not configured.
VITE_SPOTIFY_CLIENT_ID=YOUR_SPOTIFY_CLIENT_ID

# Spotify Redirect Path (optional, defaults to /spotify-callback)
# VITE_SPOTIFY_REDIRECT_PATH=/spotify-callback
